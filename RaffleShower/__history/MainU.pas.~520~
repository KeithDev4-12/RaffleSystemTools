//      Rand := GenerateUniqueRandom(10000, 89999);
//      AddAccountPanel(IntToStr(Rand), GetArea(IntToStr(Rand)));
//    end;
  end else if Upcase(Key) = 'R' then
  begin
    if Timer1.Enabled then
    begin
      Timer1.Enabled := False;
    end else
