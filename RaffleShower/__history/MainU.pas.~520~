        List.Free;
      end;
    end
    else
      ShowMessage('INI file not found: ' + FileName);
  end
  else
  begin
    if Length(FInputBuffer) >= 5 then
      Exit
    else if (Length(FInputBuffer) = 0) and (Key = '0') then
      Exit;
    FInputBuffer := FInputBuffer + Key;
  end;

  if Length(FInputBuffer) > 0  then
